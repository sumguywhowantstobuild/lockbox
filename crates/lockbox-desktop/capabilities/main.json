{
  "identifier": "main",
  "description": "The main window may call Lockbox's own commands and listen to its events; nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-list-sessions",
    "allow-lock-vault",
    "allow-lock-all",
    "allow-list-vaults",
    "allow-add-existing-vault",
    "allow-add-existing-vault-confirm",
    "allow-forget-vault",
    "allow-create-vault",
    "allow-create-vault-confirm",
    "allow-unlock-vault",
    "allow-recover-vault",
    "allow-recover-vault-confirm",
    "allow-change-password",
    "allow-regenerate-recovery",
    "allow-accept-header"
  ]
}
