# The quoted forms the reader understands.
export APP_NAME='Made Up App'
export APP_MODE=made-up-mode
APP_SPACED = made-up-value-0007
APP_LITERAL='keep $HOME and \n as written'
APP_ESCAPED="line one\nline two\ttabbed \"quoted\" back\\slash \$HOME \x"
APP_COMMENT="made-up-value-0008" # a comment after the quote
APP_BLOCK="-----BEGIN MADE-UP BLOCK-----
made-up-line-one
made-up-line-two
-----END MADE-UP BLOCK-----"
APP_AFTER=made-up-value-0009
APP_EMPTY_QUOTES=""
APP_OPEN='never closed
APP_NEXT=made-up-value-0010
APP_JUNK='made-up'junk
APP_LAST=$APP_NAME
