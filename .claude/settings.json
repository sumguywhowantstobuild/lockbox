{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/safety-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Safety guard"
          }
        ]
      }
    ]
  }
}
